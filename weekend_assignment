const r = require("raylib");
function update(world) {}

function draw(world) {
  r.BeginTextureMode(world.target1);
  r.ClearBackground(r.BLACK);

  r.DrawTriangle(
    { x: world.targetWidth, y: world.targetHeight },
    { x: world.targetWidth, y: 0 },
    { x: 0, y: world.targetHeight },
    r.WHITE,
  );
  r.DrawTriangle(
    { x: world.targetWidth, y: 0 },
    { x: 0, y: 0 },
    { x: 0, y: world.targetHeight },
    r.BLUE,
  );

  r.EndTextureMode();

  r.BeginTextureMode(world.target2);
  r.ClearBackground(r.BLACK);

  r.DrawTriangle(
    { x: 0, y: world.targetHeight },
    { x: world.targetWidth, y: world.targetHeight },
    { x: world.targetWidth, y: 0 },
    r.BLUE,
  );
  r.DrawTriangle(
    { x: 0, y: 0 },
    { x: 0, y: world.targetHeight },
    { x: world.targetWidth, y: 0 },
    r.WHITE,
  );

  r.EndTextureMode();

  r.BeginDrawing();
  r.ClearBackground(world.bg);
  const source = {
    x: 0,
    y: 0,
    width: world.targetWidth,
    height: world.targetHeight,
  };

  const noOfRows = 10;
  const noOfCols = 10;

  for (let row = 0; row < noOfRows; row++) {
    const y = row * world.targetHeight;

    for (let col = 0; col < noOfCols; col++) {
      const x = col * world.targetWidth;
      const TextureNumber = row * noOfCols + col;

      if (TextureNumber % 2 === 0)
        r.DrawTextureRec(world.target1.texture, source, { x, y }, r.WHITE);
      else
        r.DrawTextureRec(
          world.target2.texture,
          source,
          { x: x, y: y },
          r.WHITE,
        );
      // r.DrawTextureRec(
      //   world.target1.texture,
      //   source,
      //   { x: x + world.targetWidth, y },
      //   r.WHITE,
      // );
      // r.DrawTextureRec(
      //   world.target2.texture,
      //   source,
      //   { x: x + world.targetWidth, y: y + world.targetHeight },
      //   r.WHITE,
      // );
    }
  }
  r.EndDrawing();
}
// const

function drawCanvas(world, source, col, y) {
  r.DrawTextureRec(
    world.target2.texture,
    source,
    { x: (col + 10) * world.targetWidth, y },
    r.WHITE,
  );
}

function loop(world) {
  while (!r.WindowShouldClose()) {
    update(world);
    draw(world);
  }
}
function teardown() {
  r.CloseWindow();
}
function setup() {
  const TITLE = "intro";
  const WIDTH = 650;
  const HEIGHT = 300;
  const FPS = 60;
  const bg = r.BLACK;

  const targetHeight = 10;
  const targetWidth = 10;

  r.SetTraceLogLevel(r.LOG_NONE);
  r.InitWindow(WIDTH, HEIGHT, TITLE);
  r.SetTargetFPS(FPS);
  const target1 = r.LoadRenderTexture(targetWidth, targetHeight);
  const target2 = r.LoadRenderTexture(targetWidth, targetHeight);

  return {
    WIDTH,
    HEIGHT,
    TITLE,
    FPS,
    bg,
    target1,
    target2,
    targetHeight,
    targetWidth,
  };
}

function main() {
  const world = setup();
  loop(world);
  teardown();
}
main();
